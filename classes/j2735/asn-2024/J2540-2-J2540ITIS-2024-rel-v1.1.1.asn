   due-to                    (7713),  
   proceed-to                (7714),  
   transferred-to            (7715),  
   use                       (7716),  
   -- Prepositional Use
   affecting                 (7717),  
   blocking                  (7718),  
   connecting                (7719),  
   finished                  (7720),  -- Alt term: finish
   for                       (7721),  
   or                        (7722),  
   -- Other
   and                       (7723),  
   later                     (7724),  
   level                     (7725),  
   shortly                   (7726),  
   soon                      (7727),  
   service                   (7728),  
   graffiti                  (7733),  
   damaged                   (7729),  
   out-of-order              (7730),  -- See Asset Status items as well
   on-State-right-of-way     (7732),  
   found-property            (7734),  
   vandalism                 (7731),  
   major                     (7766),  
   minor                     (7767),  
   -- MUTCD Sign Usage
   begin-time                (7735),  -- Typically followed by a value entry and a
                                      -- time entry (AM/PM)
   added                     (7736),  -- Typically preceded by an object entry
   end-time                  (7737),  -- Typically followed by a value entry and a
                                      -- time entry (AM/PM)
   no                        (7738),  -- Typically followed by a value entry and
                                      -- any day/time limits
   do-not                    (7739),  -- Also used for "does not"
   block                     (7740),  -- Also used for blocks
   except                    (7741),  -- Typically followed by a value entry and a
                                      -- day/time entry
   day                       (7742),  -- Alt: daytime, daylight hours
   night                     (7743),  -- Alt: night time, night time hours
   any-time                  (7744),  -- Used also for "allowed"
   has                       (7745),  -- As in: has green (alt form: with)
   must                      (7757),  -- As in: <lane> must <turn>
   may-have                  (7746),  -- As in: may have green
   may-exceed                (7759),  -- As in: may exceed 80 mph
   only                      (7747),  
   lifted                    (7748),  -- As in gate lifted
   empty                     (7749),  
   turning                   (7750),  -- Used also for turns or turn
   u-turn                    (7751),  -- As in no u-turn allowed
   wait-for                  (7752),  
   when-flashing             (7753),  
   duration                  (7754),  -- Typically followed by a value entry and a
                                      -- time entry (Days/Hours/Min)
   cross                     (7755),  
   when-wet                  (7756),  
   oncoming                  (7758),  -- Typically followed by object or vehicle
                                      -- types
   to-request                (7760),  -- As in to request X do Y
   exempt                    (7761),  
   skewed                    (7762),  
   when-children-are-present (7763)   -- Use for S4-2
   } (0..65535)
   -- Modifiers and parts of sentences


