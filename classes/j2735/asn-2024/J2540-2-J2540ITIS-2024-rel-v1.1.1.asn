   partly                    (7702),  
   minus                     (7703),  
   weather-ended             (7704),  
   expected                  (7705),  
   low                       (7706),  -- Typically used in temperatures. See also "upper"
   mid                       (7707),  
   high                      (7708),  
   upper                     (7709),  -- Typically used in temperatures or broad regions. 
                                      -- See also C"b,ElowC"b,B?, C"b,B?midC"b,B?, C"b,EhighC"b,B?, C"b,EmiddleC"b,B?
